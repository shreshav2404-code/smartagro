[Unit]
Description=Gunicorn instance to serve SmartAgro Backend
After=network.target

[Service]
User=azureuser
Group=azureuser
WorkingDirectory=/home/azureuser/.openclaw/workspace/projects/smartagro/backend
Environment="PATH=/home/azureuser/.openclaw/workspace/projects/smartagro/backend/venv/bin"
Environment="DJANGO_SETTINGS_MODULE=backend.settings"
Environment="SUPABASE_DB_URL=postgresql://postgres.dvtabjxxflpvyuarczcc:@Keshav2404@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"
Environment="GEMINI_API_KEY=YOUR_GEMINI_API_KEY"
ExecStart=/home/azureuser/.openclaw/workspace/projects/smartagro/backend/venv/bin/gunicorn \
    --workers 3 \
    --bind 0.0.0.0:8000 \
    backend.wsgi:application

[Install]
