[Unit]
Description=Gunicorn instance to serve SmartAgro Backend
After=network.target

[Service]
User=azureuser
Group=azureuser
WorkingDirectory=/home/azureuser/.openclaw/workspace/projects/smartagro/backend
Environment="PATH=/home/azureuser/.local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/python3 -m gunicorn --workers 3 --bind 0.0.0.0:8000 backend.wsgi:application --timeout 120
Restart=always

[Install]
WantedBy=multi-user.target
